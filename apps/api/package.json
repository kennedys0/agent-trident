{
  "name": "@trident/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../../packages/api-contract/scripts/ensure-dist.mjs && tsx watch src/server.ts",
    "build": "pnpm --filter @trident/api-contract build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @trident/api-contract build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @trident/api-contract build && vitest run",
    "test:watch": "pnpm --filter @trident/api-contract build && vitest"
  },
  "dependencies": {
    "@trident/api-contract": "workspace:*",
    "fastify": "^5.2.0",
    "viem": "^2.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
